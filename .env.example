# Supabase — https://app.supabase.com/project/_/settings/api
# NEXT_PUBLIC_SUPABASE_URL must be set under exactly this name: Next.js
# only exposes NEXT_PUBLIC_-prefixed vars to the browser, so if you connect
# via the Vercel<->Supabase integration and it only creates a bare
# SUPABASE_URL, add this one yourself with the same value.
NEXT_PUBLIC_SUPABASE_URL=
# Either name works — the code falls back automatically. Supabase renamed
# "anon key" to "publishable key" in 2025; some integration flows only set
# the new name (NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY).
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Either name works — same fallback as above ("service_role key" -> "secret
# key": SUPABASE_SECRET_KEY).
SUPABASE_SERVICE_ROLE_KEY=

# Stripe — https://dashboard.stripe.com/apikeys (use test keys in development)
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# Claude API — https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Resend — https://resend.com/api-keys
RESEND_API_KEY=
EMAIL_FROM="WINDOW <hello@yourdomain.com>"

# PostHog — https://eu.posthog.com/project/settings (EU host by default per AVG)
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com

# App
NEXT_PUBLIC_SITE_URL=http://localhost:3000
