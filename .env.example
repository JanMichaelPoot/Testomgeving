# Supabase — https://app.supabase.com/project/_/settings/api
# NEXT_PUBLIC_SUPABASE_URL must be set under exactly this name: Next.js
# only exposes NEXT_PUBLIC_-prefixed vars to the browser, so if you connect
# via the Vercel<->Supabase integration and it only creates a bare
# SUPABASE_URL, add this one yourself with the same value.
NEXT_PUBLIC_SUPABASE_URL=
# Either name works — the code falls back automatically. Supabase renamed
# "anon key" to "publishable key" in 2025; some integration flows only set
# the new name (NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY).
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Either name works — same fallback as above ("service_role key" -> "secret
# key": SUPABASE_SECRET_KEY).
SUPABASE_SERVICE_ROLE_KEY=

# Stripe — https://dashboard.stripe.com/apikeys (use test keys in development)
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# Claude API — https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Gemini API (illustrations on the ideas cards and Window Plan, via the
# "Nano Banana Pro" image model) — https://aistudio.google.com/api-keys
# Must be a real Gemini API key (starts with "AIzaSy"), not an OAuth
# access token copied from a browser session (those look like "AQ....").
GEMINI_API_KEY=

# Resend — https://resend.com/api-keys
RESEND_API_KEY=
EMAIL_FROM="WINDOW <hello@yourdomain.com>"

# PostHog — https://eu.posthog.com/project/settings (EU host by default per AVG)
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com

# Cron auth — protects /api/cron/first-action-reminder from being triggered
# by anyone who finds the URL. Vercel automatically sends this as a Bearer
# token when the same-named env var is set on the project (see vercel.json's
# `crons` entry); generate any random secret string, e.g. `openssl rand -hex 32`.
CRON_SECRET=

# Admin logboek (/admin) — protects the anonymous intake/output audit log
# behind a single shared password. Pick your own, e.g. `openssl rand -hex 16`.
# Leaving this empty disables /admin entirely rather than allowing an empty
# password in.
ADMIN_PASSWORD=


# App
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Share (0-100) of visitors who get the visual card wizard instead of the classic
# one. Unset or empty = 100 (everybody, the default); 0 = nobody. ?wizard=cards or
# ?wizard=legacy on /intake always forces one of them for testing.
NEXT_PUBLIC_DISCOVERY_WIZARD_PERCENT=100

# "Het venster" (WindowInto/WINDOW_Bouwopdracht_Venster_Fase0-8.md).
# Share (0-100) of visitors who get the image intake and the new landing. Unset or empty = 100
# (everybody, the default); 0 switches it off. ?wizard=associations forces the intake in one tab,
# ?venster=1 the new landing for one visit.
NEXT_PUBLIC_ASSOCIATION_WIZARD_PERCENT=100
# Share (0-100) of visitors who get the two-page image intake (docs/fase4-opzet.md). Default 0: nobody; ?wizard=images2 shows it for one tab.
# It is drawn before the four-round image intake above. NEXT_PUBLIC_*: baked in at build time.
NEXT_PUBLIC_IMAGES2_PERCENT=0
# Price in whole euro cents (default 350). 600 on the test preview.
NEXT_PUBLIC_WINDOW_PRICE_CENTS=
# 1 shows the short tester questionnaire under the Idea Book (test preview only).
NEXT_PUBLIC_TEST_FEEDBACK=
# Test phase: at most this many books per internet connection (IP address). Unset or 0 = no limit.
# The address itself is never stored, only a keyed hash (supabase/migrations/0021_test_quota.sql).
# You, logged in at /admin in your browser, are never limited.
TEST_MAX_BOOKS_PER_IP=
# Addresses that are never limited (comma-separated), for example your own. Look yours up on /admin (the test-limit block shows it
# the way the server sees it, which can be an IPv6 address). Set it in Vercel, not in the repo.
TEST_QUOTA_EXEMPT_IPS=
# Optional secret for that hash. Unset = derived from the Supabase service key.
IP_HASH_SECRET=

# Knowledge engine, two switches (server-side; off unless 1/true/yes/on; docs/verbeterplan-windowinto.md, D9):
#   KNOWLEDGE_RANKING_V2  B4: stepwise ranking with diversity, no unknown cost for a free budget, measured fit and reasons per idea.
#   KNOWLEDGE_WRITING_V2  B5: activity-specific fill lines, honest origin wording, visible chain. Costs about $0.02 more per
#                         book and ~20 s more writing time (docs/eval, Stap 99); the blind comparison split 2-2.
# The old KNOWLEDGE_ENGINE_V2 still works and means both on.
KNOWLEDGE_RANKING_V2=
KNOWLEDGE_WRITING_V2=
KNOWLEDGE_ENGINE_V2=
